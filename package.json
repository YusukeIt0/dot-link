{
  "name": "even-g2-dot",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "bridge": "node server/main.ts",
    "bridge:init": "node server/init.ts",
    "bridge:check": "node scripts/check-bridge.mjs",
    "tunnel:save-key": "node scripts/save-tunnel-key.mjs",
    "tunnel:prepare": "node scripts/prepare-tunnel.mjs",
    "test:http": "node --test tests/*.integration.ts",
    "package:release": "npm run build:release && node scripts/package-even.mjs --release",
    "package:beta": "npm run build && node scripts/package-beta.mjs",
    "beta:pair": "node scripts/beta-pair.mjs",
    "prebuild": "node scripts/prepare-wake-assets.mjs",
    "predev": "node scripts/prepare-wake-assets.mjs",
    "pretest": "node scripts/prepare-wake-assets.mjs",
    "build:release": "node scripts/prepare-wake-assets.mjs && tsc --noEmit && vite build --mode release"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "0.1.4",
    "ipaddr.js": "2.5.0",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "license": "MIT"
}
